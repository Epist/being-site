---
import Base from '../layouts/Base.astro';
---
<Base>
    <section class="hero">
        <div class="container">
            <h1 class="logo"><span class="be">be</span><span class="love">love</span></h1>
            <p class="tagline">your digital life organized<br>by you, for you</p>
            <form class="waitlist subtitle">
                <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true">
                <input type="email" name="email" required placeholder="email" autocomplete="email">
                <button type="submit">join the waitlist</button>
            </form>
        </div>
        <a class="scroll-hint" href="#story" aria-label="read more">↓</a>
    </section>

    <section class="section" id="story">
        <h2>the noise</h2>
        <p>Every feed on your phone wants something from you. Your feeds are tuned to pull you in. What matters to you is buried in what profits someone else.</p>
    </section>

    <section class="section">
        <h2>one quiet surface</h2>
        <p>belove sits between you and the digital world. It gathers your messages, feeds, and events in one place and filters them through a single question:<br><em>what do you really need right now?</em></p>
    </section>

    <section class="section">
        <h2>tuned by you</h2>
        <p>You tune belove to your interests, your goals, and the person you're becoming. There are no engagement tricks and no optimizing for clicks. belove simply shows you what helps.</p>
    </section>

    <section class="section">
        <h2>built to be trusted</h2>
        <p>belove is made by BeingWell Technologies, a public benefit corporation. We don't sell ads and we don't monetize your attention. We do well only when you're well.</p>
        <p><a href="/about/">more about us</a></p>
    </section>

    <section class="section">
        <h2>be first</h2>
        <p>belove is in early development. Leave your email and we'll be in touch as it becomes real.</p>
        <form class="waitlist subtitle">
            <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true">
            <input type="email" name="email" required placeholder="email" autocomplete="email">
            <button type="submit">join the waitlist</button>
        </form>
    </section>

    <script>
        document.querySelectorAll('form.waitlist').forEach((form) => {
            form.addEventListener('submit', async (e) => {
                e.preventDefault();
                if (form.website.value) {
                    // Honeypot filled: a bot. Show success without submitting.
                    form.outerHTML = "<p class=\"subtitle\">We'll be in touch.</p>";
                    return;
                }
                const email = form.email.value;
                try {
                    await fetch('https://script.google.com/macros/s/AKfycbwgvQZokvo5vzS4Ngs2PmpyJjQYX3zdo_BwuErL0ehHaKFgydop0AwDJTU4ALrawFwhfw/exec', {
                        method: 'POST',
                        mode: 'no-cors',
                        body: JSON.stringify({ email })
                    });
                    form.outerHTML = "<p class=\"subtitle\">We'll be in touch.</p>";
                } catch {
                    form.outerHTML = "<p class=\"subtitle\">Something went wrong. Try again in a moment.</p>";
                }
            });
        });
    </script>
</Base>
