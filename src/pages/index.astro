---
import Base from '../layouts/Base.astro';
---
<Base>
    <section class="hero">
        <div class="container">
            <h1 class="logo"><span class="be">be</span><span class="love">love</span></h1>
            <div class="tag-wrap">
                <!-- The heartflower as a soft glow, centered just above the tagline -->
                <svg class="glow" viewBox="0 0 300 300" aria-hidden="true"><use href="/heartflower-lines.svg#flower"/></svg>
                <p class="tagline">your digital life designed<br>by you, for you</p>
            </div>
            <form class="waitlist subtitle">
                <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true">
                <div class="pill">
                    <input type="email" name="email" required placeholder="your email here" autocomplete="email">
                    <button type="submit" aria-label="join the waitlist">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
                    </button>
                    <span class="note" aria-hidden="true">join the waitlist</span>
                    <svg class="note-arrow" aria-hidden="true" viewBox="0 0 32 24"><path d="M3 22 C 13 21, 21 14, 24 4.5"/><path d="M19 7.5 L24 4 L26.5 10.5"/></svg>
                </div>
            </form>
        </div>
        <a class="scroll-hint" href="#story" aria-label="read more">↓</a>
    </section>

    <section class="section" id="story">
        <h2>one magical surface</h2>
        <p class="river"><span class="bl">belove</span> gathers your messages, feeds, events, and other inbound streams<br class="wide"> into one river and asks a single question:<br><em>what do you really need right now?</em></p>
        <p>What matters rises to the surface. The rest flows on.</p>
        <figure class="diagram" aria-label="many streams in, one calm center">
            <svg class="flower" viewBox="0 0 300 300" aria-hidden="true"><use href="/heartflower-lines.svg#flower"/></svg>
            <span class="lbl l" style="--x:11%;--y:31%">messages</span>
            <span class="lbl r" style="--x:89%;--y:31%">feeds</span>
            <span class="lbl l" style="--x:10%;--y:67%">events</span>
            <span class="lbl r" style="--x:90%;--y:67%">news</span>
            <span class="lbl" style="--x:31%;--y:95%">calendar</span>
            <span class="lbl" style="--x:69%;--y:95%">. . .</span>
            <span class="lbl you" style="--x:50%;--y:50%">you</span>
        </figure>
    </section>

    <section class="section">
        <h2>tuned by you</h2>
        <p>You tune <span class="bl">belove</span> to your interests, your goals, and the person you're becoming. There are no engagement tricks and no optimizing for clicks. <span class="bl">belove</span> simply shows you what helps.</p>
    </section>

    <section class="section">
        <h2>built to be trusted</h2>
        <p><span class="bl">belove</span> is made by BeingWell Technologies, a public benefit corporation. We don't sell ads or your attention. We do well only when you're well.</p>
        <p><a href="/about/">more about us</a></p>
    </section>

    <section class="section">
        <h2>be first</h2>
        <p><span class="bl">belove</span> is in early development.</p>
        <form class="waitlist subtitle">
            <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true">
                <div class="pill">
                <input type="email" name="email" required placeholder="your email here" autocomplete="email">
                <button type="submit" aria-label="join the waitlist">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
                </button>
                <span class="note" aria-hidden="true">join the waitlist</span>
                <svg class="note-arrow" aria-hidden="true" viewBox="0 0 32 24"><path d="M3 22 C 13 21, 21 14, 24 4.5"/><path d="M19 7.5 L24 4 L26.5 10.5"/></svg>
            </div>
        </form>
    </section>

    <script>
        document.querySelectorAll('form.waitlist').forEach((form) => {
            form.addEventListener('submit', async (e) => {
                e.preventDefault();
                if (form.website.value) {
                    // Honeypot filled: a bot. Show success without submitting.
                    form.outerHTML = "<p class=\"subtitle\">We'll be in touch.</p>";
                    return;
                }
                const email = form.email.value;
                try {
                    await fetch('https://script.google.com/macros/s/AKfycbwgvQZokvo5vzS4Ngs2PmpyJjQYX3zdo_BwuErL0ehHaKFgydop0AwDJTU4ALrawFwhfw/exec', {
                        method: 'POST',
                        mode: 'no-cors',
                        body: JSON.stringify({ email })
                    });
                    form.outerHTML = "<p class=\"subtitle\">We'll be in touch.</p>";
                } catch {
                    form.outerHTML = "<p class=\"subtitle\">Something went wrong. Try again in a moment.</p>";
                }
            });
        });
    </script>
</Base>
